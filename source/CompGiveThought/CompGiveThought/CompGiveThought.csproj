<Project Sdk="Microsoft.NET.Sdk">

  <!--
    同一份原始碼同時建置兩個遊戲版本（做法同 Fortified-Framework 的 Fortified.csproj）：
      net472   → RimWorld 1.6（.NET Framework / Unity）→ 1.6/Assemblies
      net10.0  → RimWorld 1.7（.NET 10 / Waylith）    → 1.7/Assemblies，並定義 RW_1_7
    1.7 沒有參考組件套件，直接參考遊戲本體的 DLL；預設假設本模組位於 <RimWorld>/Mods/<模組>/，
    遊戲裝在別處時以 -p:RimWorldDir=<遊戲目錄>\ 覆寫。只建置其中一版：-f net472 或 -f net10.0。
    Builds both game versions from the same source (same setup as Fortified-Framework's Fortified.csproj):
      net472  → RimWorld 1.6 (.NET Framework / Unity) → 1.6/Assemblies
      net10.0 → RimWorld 1.7 (.NET 10 / Waylith)       → 1.7/Assemblies, defines RW_1_7
    1.7 has no reference-assembly package, so the game's own DLLs are referenced; override the game path
    with -p:RimWorldDir=<game dir>\ when the mod is not under <RimWorld>/Mods/<mod>/. Build one version with -f.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <RootNamespace>CompGiveThought</RootNamespace>
    <AssemblyName>CompGiveThought</AssemblyName>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <!-- Properties/AssemblyInfo.cs 已提供組件屬性。Properties/AssemblyInfo.cs already supplies the assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\..\</RimWorldDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <OutputPath>$(MSBuildThisFileDirectory)..\..\..\1.6\Assemblies\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <OutputPath>$(MSBuildThisFileDirectory)..\..\..\1.7\Assemblies\</OutputPath>
    <DefineConstants>$(DefineConstants);RW_1_7</DefineConstants>
    <!-- 遊戲只載入 Assemblies 內的 .dll，不需要 deps.json。The game only loads the .dll, so no deps.json. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4850" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- 1.7 的 UnityEngine.* 型別全部由 UnityStubs 提供。In 1.7 every UnityEngine.* type comes from UnityStubs. -->
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)Waylith.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
